# Neon (server-only, JANGAN pakai prefix VITE_)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Login admin (server-only)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-password-kuat"
ADMIN_TOKEN="token-acak-panjang"

# Path admin (build-time, hanya kamuflase — bukan pengaman)
VITE_ADMIN_SECRET_PATH="/admin-khalid-bin-wallid"

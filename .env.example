# Neon (server-only, JANGAN pakai prefix VITE_)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Login admin (server-only)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-password-kuat"
# Kunci HMAC sesi admin + URL video (64 karakter hex)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN="64-karakter-hex"

# Path admin (build-time, hanya kamuflase — bukan pengaman)
VITE_ADMIN_SECRET_PATH="/admin-khalid-bin-wallid"
